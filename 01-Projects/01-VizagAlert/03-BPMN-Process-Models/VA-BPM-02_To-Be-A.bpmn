<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_VizagAlert_To_Be_A_Submit_and_Route" targetNamespace="http://vizagalert.local/bpmn">
<bpmn:collaboration id="Collab_VizagAlert_To_Be_A_Submit_and_Route"><bpmn:participant id="Part_VizagAlert_To_Be_A_Submit_and_Route" name="VizagAlert To-Be A Submit and Route" processRef="Proc_VizagAlert_To_Be_A_Submit_and_Route"/></bpmn:collaboration>
<bpmn:process id="Proc_VizagAlert_To_Be_A_Submit_and_Route" isExecutable="false"><bpmn:laneSet id="LS_VizagAlert_To_Be_A_Submit_and_Route">
<bpmn:lane id="Lane_0" name="Citizen (guest or verified)"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_1" name="VizagAlert platform"><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t3</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t5</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t6</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t7</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_2" name="WhatsApp (Twilio)"><bpmn:flowNodeRef>N_t8</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_3" name="Department Alert Handler"><bpmn:flowNodeRef>N_t9</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e1</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Issue noticed"><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="N_t1" name="Choose department and category"><bpmn:incoming>F_1</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t2" name="Allow GPS and camera; capture live photo; describe issue"><bpmn:incoming>F_2</bpmn:incoming><bpmn:incoming>F_4</bpmn:incoming><bpmn:outgoing>F_3</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="N_g1" name="GPS valid, in area, image valid?"><bpmn:incoming>F_3</bpmn:incoming><bpmn:outgoing>F_4</bpmn:outgoing><bpmn:outgoing>F_5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="N_t3" name="Burn UTC time and address into photo; create ticket (ID, status Request)"><bpmn:incoming>F_5</bpmn:incoming><bpmn:outgoing>F_6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="N_g2" name="Open duplicate within 50 m / 24 h?"><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing><bpmn:outgoing>F_9</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="N_t5" name="Link to master ticket; add to report count; no new SLA clock"><bpmn:incoming>F_7</bpmn:incoming><bpmn:outgoing>F_8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="N_e2" name="Master ID shown to citizen"><bpmn:incoming>F_8</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="N_t6" name="Auto-assign queue, priority and SLA due times"><bpmn:incoming>F_9</bpmn:incoming><bpmn:outgoing>F_10</bpmn:outgoing><bpmn:outgoing>F_11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="N_t7" name="Push to department dashboard with alert tone"><bpmn:incoming>F_10</bpmn:incoming><bpmn:outgoing>F_12</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="N_t8" name="WhatsApp to department number + 7 supervisors"><bpmn:incoming>F_11</bpmn:incoming><bpmn:outgoing>F_13</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="N_t9" name="Alert Handler reviews ticket, photo and GPS"><bpmn:incoming>F_12</bpmn:incoming><bpmn:incoming>F_13</bpmn:incoming><bpmn:outgoing>F_14</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="N_e1" name="Continues in Diagram B"><bpmn:incoming>F_14</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_1" sourceRef="N_s" targetRef="N_t1"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_t1" targetRef="N_t2"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_t2" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_g1" targetRef="N_t2" name="No: show error, retry"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_g1" targetRef="N_t3" name="Yes"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_t3" targetRef="N_g2"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_g2" targetRef="N_t5" name="Yes"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_t5" targetRef="N_e2"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_g2" targetRef="N_t6" name="No"/>
<bpmn:sequenceFlow id="F_10" sourceRef="N_t6" targetRef="N_t7"/>
<bpmn:sequenceFlow id="F_11" sourceRef="N_t6" targetRef="N_t8"/>
<bpmn:sequenceFlow id="F_12" sourceRef="N_t7" targetRef="N_t9"/>
<bpmn:sequenceFlow id="F_13" sourceRef="N_t8" targetRef="N_t9"/>
<bpmn:sequenceFlow id="F_14" sourceRef="N_t9" targetRef="N_e1"/>
</bpmn:process>
