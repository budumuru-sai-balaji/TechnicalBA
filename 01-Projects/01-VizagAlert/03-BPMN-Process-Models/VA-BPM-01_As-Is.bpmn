<bpmn:sequenceFlow id="F_7" sourceRef="N_g" targetRef="N_t6" name="Yes"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_t6" targetRef="N_t7"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_t7" targetRef="N_e"/>
<bpmn:sequenceFlow id="F_10" sourceRef="N_g" targetRef="N_t5" name="No: wait for material or permission, revisit"/>
</bpmn:process>
