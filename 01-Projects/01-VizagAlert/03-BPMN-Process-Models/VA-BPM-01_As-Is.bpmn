<bpmn:collaboration id="Collab_VizagAlert_As_Is_Manual_Complaint_Handling"><bpmn:participant id="Part_VizagAlert_As_Is_Manual_Complaint_Handling" name="VizagAlert As-Is Manual Complaint Handling" processRef="Proc_VizagAlert_As_Is_Manual_Complaint_Handling"/></bpmn:collaboration>
<bpmn:process id="Proc_VizagAlert_As_Is_Manual_Complaint_Handling" isExecutable="false"><bpmn:laneSet id="LS_VizagAlert_As_Is_Manual_Complaint_Handling">
<bpmn:lane id="Lane_0" name="Citizen"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_1" name="Helpline / counter clerk"><bpmn:flowNodeRef>N_t2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t3</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t7</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_2" name="Department supervisor"><bpmn:flowNodeRef>N_t4</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t6</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_3" name="Field staff"><bpmn:flowNodeRef>N_t5</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Problem noticed"><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="N_t1" name="Phones helpline, visits office or messages a known officer"><bpmn:incoming>F_1</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t2" name="Clerk notes details in a register or Excel sheet"><bpmn:incoming>F_2</bpmn:incoming><bpmn:outgoing>F_3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t3" name="Chooses department by judgement; forwards by phone or WhatsApp"><bpmn:incoming>F_3</bpmn:incoming><bpmn:outgoing>F_4</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t4" name="Supervisor receives request and assigns staff verbally"><bpmn:incoming>F_4</bpmn:incoming><bpmn:outgoing>F_5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t5" name="Staff call the citizen to find the spot, then visit"><bpmn:incoming>F_5</bpmn:incoming><bpmn:incoming>F_10</bpmn:incoming><bpmn:outgoing>F_6</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="N_g" name="Fixed on this visit?"><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing><bpmn:outgoing>F_10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="N_t6" name="Supervisor told by phone; clerk informed later, if at all"><bpmn:incoming>F_7</bpmn:incoming><bpmn:outgoing>F_8</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t7" name="Register updated by hand; entry closed"><bpmn:incoming>F_8</bpmn:incoming><bpmn:outgoing>F_9</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="N_e" name="Citizen rarely told"><bpmn:incoming>F_9</bpmn:incoming></bpmn:endEvent>
<bpmn:textAnnotation id="N_n"><bpmn:text>Citizen has no ID or tracking and keeps phoning for updates (8)</bpmn:text></bpmn:textAnnotation>
