<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_VizagAlert_To_Be_B_Triage_and_Resolution" targetNamespace="http://vizagalert.local/bpmn">
<bpmn:collaboration id="Collab_VizagAlert_To_Be_B_Triage_and_Resolution"><bpmn:participant id="Part_VizagAlert_To_Be_B_Triage_and_Resolution" name="VizagAlert To-Be B Triage and Resolution" processRef="Proc_VizagAlert_To_Be_B_Triage_and_Resolution"/></bpmn:collaboration>
<bpmn:process id="Proc_VizagAlert_To_Be_B_Triage_and_Resolution" isExecutable="false"><bpmn:laneSet id="LS_VizagAlert_To_Be_B_Triage_and_Resolution">
<bpmn:lane id="Lane_0" name="VizagAlert platform"><bpmn:flowNodeRef>N_t9</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_1" name="Super Admin"><bpmn:flowNodeRef>N_t8</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e3</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_2" name="Alert Handler"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t3</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t5</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_3" name="Field Inspector"><bpmn:flowNodeRef>N_w</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g4</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t6</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e5</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_4" name="Citizen"><bpmn:flowNodeRef>N_t7</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g3</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e4</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Alert received"><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="N_t1" name="Acknowledge; review photo, GPS and time"><bpmn:incoming>F_1</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="N_g1" name="Right department?"><bpmn:incoming>F_2</bpmn:incoming><bpmn:outgoing>F_3</bpmn:outgoing><bpmn:outgoing>F_4</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="N_t2" name="Raise reassignment request with reason"><bpmn:incoming>F_4</bpmn:incoming><bpmn:outgoing>F_5</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t3" name="Set status Active; assign Field Inspector"><bpmn:incoming>F_3</bpmn:incoming><bpmn:outgoing>F_10</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t8" name="Review request; approve or reject"><bpmn:incoming>F_5</bpmn:incoming><bpmn:outgoing>F_6</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="N_g2" name="Approved?"><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing><bpmn:outgoing>F_8</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="N_t9" name="Move to new queue; SLA clock continues; audit entry"><bpmn:incoming>F_7</bpmn:incoming><bpmn:outgoing>F_9</bpmn:outgoing></bpmn:serviceTask>
<bpmn:endEvent id="N_e1" name="New department restarts at triage"><bpmn:incoming>F_9</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="N_e3" name="Rejected: handler notified, ticket stays"><bpmn:incoming>F_8</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="N_w" name="Inspect site and carry out the work"><bpmn:incoming>F_10</bpmn:incoming><bpmn:incoming>F_14</bpmn:incoming><bpmn:outgoing>F_11</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="N_g4" name="Work complete?"><bpmn:incoming>F_11</bpmn:incoming><bpmn:outgoing>F_12</bpmn:outgoing><bpmn:outgoing>F_13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="N_t5" name="Set Hold with reason code; SLA clock pauses"><bpmn:incoming>F_13</bpmn:incoming><bpmn:outgoing>F_14</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t6" name="Add remark and after-photo; set Resolved"><bpmn:incoming>F_12</bpmn:incoming><bpmn:outgoing>F_15</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_t7" name="Receives Resolved notice; rates the work"><bpmn:incoming>F_15</bpmn:incoming><bpmn:outgoing>F_16</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="N_g3" name="Satisfied?"><bpmn:incoming>F_16</bpmn:incoming><bpmn:outgoing>F_17</bpmn:outgoing><bpmn:outgoing>F_18</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="N_e4" name="Closed"><bpmn:incoming>F_17</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="N_e5" name="Reopened (7 days): back to review"><bpmn:incoming>F_18</bpmn:incoming></bpmn:endEvent>
<bpmn:textAnnotation id="N_n"><bpmn:text>On every status change the platform writes an audit entry and refreshes the citizen dashboard (FR-17, FR-21, FR-30)</bpmn:text></bpmn:textAnnotation>
<bpmn:sequenceFlow id="F_1" sourceRef="N_s" targetRef="N_t1"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_t1" targetRef="N_g1"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_g1" targetRef="N_t3" name="Yes"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_g1" targetRef="N_t2" name="No"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_t2" targetRef="N_t8"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_t8" targetRef="N_g2"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_g2" targetRef="N_t9" name="Yes"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_g2" targetRef="N_e3" name="No"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_t9" targetRef="N_e1"/>
<bpmn:sequenceFlow id="F_10" sourceRef="N_t3" targetRef="N_w"/>
<bpmn:sequenceFlow id="F_11" sourceRef="N_w" targetRef="N_g4"/>
<bpmn:sequenceFlow id="F_12" sourceRef="N_g4" targetRef="N_t6" name="Yes"/>
<bpmn:sequenceFlow id="F_13" sourceRef="N_g4" targetRef="N_t5" name="No"/>
<bpmn:sequenceFlow id="F_14" sourceRef="N_t5" targetRef="N_w" name="Blocker cleared: back to Active"/>
<bpmn:sequenceFlow id="F_15" sourceRef="N_t6" targetRef="N_t7"/>
<bpmn:sequenceFlow id="F_16" sourceRef="N_t7" targetRef="N_g3"/>
<bpmn:sequenceFlow id="F_17" sourceRef="N_g3" targetRef="N_e4" name="Yes"/>
<bpmn:sequenceFlow id="F_18" sourceRef="N_g3" targetRef="N_e5" name="No"/>
</bpmn:process>
