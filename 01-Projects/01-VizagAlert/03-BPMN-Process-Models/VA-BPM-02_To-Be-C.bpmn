<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_VizagAlert_To_Be_C_SLA_Monitoring_and_Escalation" targetNamespace="http://vizagalert.local/bpmn">
<bpmn:collaboration id="Collab_VizagAlert_To_Be_C_SLA_Monitoring_and_Escalation"><bpmn:participant id="Part_VizagAlert_To_Be_C_SLA_Monitoring_and_Escalation" name="VizagAlert To-Be C SLA Monitoring and Escalation" processRef="Proc_VizagAlert_To_Be_C_SLA_Monitoring_and_Escalation"/></bpmn:collaboration>
<bpmn:process id="Proc_VizagAlert_To_Be_C_SLA_Monitoring_and_Escalation" isExecutable="false"><bpmn:laneSet id="LS_VizagAlert_To_Be_C_SLA_Monitoring_and_Escalation">
<bpmn:lane id="Lane_0" name="VizagAlert SLA engine"><bpmn:flowNodeRef>N_s</bpmn:flowNodeRef><bpmn:flowNodeRef>N_t1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_g</bpmn:flowNodeRef><bpmn:flowNodeRef>N_e0</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_1" name="Assignee (handler / inspector)"><bpmn:flowNodeRef>N_a0</bpmn:flowNodeRef><bpmn:flowNodeRef>N_xa0</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_2" name="Department Supervisor (L1)"><bpmn:flowNodeRef>N_a1</bpmn:flowNodeRef><bpmn:flowNodeRef>N_xa1</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_3" name="Department Head (L2)"><bpmn:flowNodeRef>N_a2</bpmn:flowNodeRef><bpmn:flowNodeRef>N_xa2</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_4" name="Super Admin (L3)"><bpmn:flowNodeRef>N_a3</bpmn:flowNodeRef><bpmn:flowNodeRef>N_xa3</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="N_s" name="Every 5 minutes"><bpmn:outgoing>F_5</bpmn:outgoing><bpmn:timerEventDefinition id="TD_s"/></bpmn:startEvent>
<bpmn:serviceTask id="N_t1" name="Compare open tickets with SLA due times (Hold time excluded)"><bpmn:incoming>F_5</bpmn:incoming><bpmn:outgoing>F_6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="N_g" name="Share of SLA time used"><bpmn:incoming>F_6</bpmn:incoming><bpmn:outgoing>F_7</bpmn:outgoing><bpmn:outgoing>F_8</bpmn:outgoing><bpmn:outgoing>F_9</bpmn:outgoing><bpmn:outgoing>F_10</bpmn:outgoing><bpmn:outgoing>F_11</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="N_e0" name="Within SLA: no action"><bpmn:incoming>F_7</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="N_a3" name="Critical alert; take ownership or re-route ticket"><bpmn:incoming>F_8</bpmn:incoming><bpmn:outgoing>F_1</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_a2" name="Severe alert; direct resources; acknowledge in 30 min"><bpmn:incoming>F_9</bpmn:incoming><bpmn:outgoing>F_2</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_a1" name="Breach alert; acknowledge in 30 min; add resources or reassign"><bpmn:incoming>F_10</bpmn:incoming><bpmn:outgoing>F_3</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="N_a0" name="Reminder; expedite or log a valid Hold"><bpmn:incoming>F_11</bpmn:incoming><bpmn:outgoing>F_4</bpmn:outgoing></bpmn:userTask>
<bpmn:endEvent id="N_xa3" name="Logged; monitoring continues"><bpmn:incoming>F_1</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="N_xa2" name="Logged; monitoring continues"><bpmn:incoming>F_2</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="N_xa1" name="Logged; monitoring continues"><bpmn:incoming>F_3</bpmn:incoming></bpmn:endEvent>
<bpmn:endEvent id="N_xa0" name="Logged; monitoring continues"><bpmn:incoming>F_4</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F_1" sourceRef="N_a3" targetRef="N_xa3"/>
<bpmn:sequenceFlow id="F_2" sourceRef="N_a2" targetRef="N_xa2"/>
<bpmn:sequenceFlow id="F_3" sourceRef="N_a1" targetRef="N_xa1"/>
<bpmn:sequenceFlow id="F_4" sourceRef="N_a0" targetRef="N_xa0"/>
<bpmn:sequenceFlow id="F_5" sourceRef="N_s" targetRef="N_t1"/>
<bpmn:sequenceFlow id="F_6" sourceRef="N_t1" targetRef="N_g"/>
<bpmn:sequenceFlow id="F_7" sourceRef="N_g" targetRef="N_e0" name="Under warning level"/>
<bpmn:sequenceFlow id="F_8" sourceRef="N_g" targetRef="N_a3" name="200%+ (P1 150%)"/>
<bpmn:sequenceFlow id="F_9" sourceRef="N_g" targetRef="N_a2" name="150% (P1 125%)"/>
<bpmn:sequenceFlow id="F_10" sourceRef="N_g" targetRef="N_a1" name="100% breach"/>
<bpmn:sequenceFlow id="F_11" sourceRef="N_g" targetRef="N_a0" name="Warning level"/>
</bpmn:process>
